# Master GitIgnore for BiteDash Food Delivery App

# Compiled Java Classes & Build Targets
**/target/classes/
**/target/maven-archiver/
**/target/maven-status/
**/target/generated-sources/
**/*.class
**/*.war
**/*.ear

# Frontend Node modules & builds
**/node_modules/
**/dist/
**/build/
.eslintcache

# Logs & Temporary files
*.log
**/logs/
**/.system_generated/
**/*.tmp
**/*.temp

# Docker local volumes & databases
**/mysql_data/
**/redis_data/
**/.data/

# IDE Configuration folders
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# Local environments configuration
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
